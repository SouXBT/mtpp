// Skema database Sistem Distribusi MTPP (Prisma ORM, PostgreSQL)
// 30 tabel utama sesuai CDM/PDM Lampiran C + tabel pendukung.
// Kolom berawalan mtpp_ mengikuti aturan khusus perusahaan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id                    Int            @id @default(autoincrement())
  partnerId             Int            @map("partner_id")
  login                 String         @unique(map: "users_login_unique") @db.VarChar(120)
  password              String         @db.VarChar(200)
  active                Boolean        @default(true)
  loginDate             DateTime?      @map("login_date") @db.Timestamp(6)
  signatureId           Int?           @map("signature_attachment_id")
  createUid             Int?           @map("create_uid")
  createDate            DateTime       @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid              Int?           @map("write_uid")
  writeDate             DateTime       @default(now()) @map("write_date") @db.Timestamp(6)
  groups                GroupUsers[]   @relation("groupUsers_uid")
  revActivitiesUserId   Activities[]   @relation("activities_userId")
  revSavedFiltersUserId SavedFilters[] @relation("savedFilters_userId")
  partner               Partners       @relation("users_partnerId", fields: [partnerId], references: [id], map: "users_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)

  @@map("users")
}

model Groups {
  id          Int                @id @default(autoincrement())
  code        String             @unique(map: "groups_code_unique") @db.VarChar(30)
  name        String             @db.VarChar(80)
  comment     String?            @db.Text
  createUid   Int?               @map("create_uid")
  createDate  DateTime           @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid    Int?               @map("write_uid")
  writeDate   DateTime           @default(now()) @map("write_date") @db.Timestamp(6)
  users       GroupUsers[]       @relation("groupUsers_gid")
  permissions GroupPermissions[] @relation("groupPermissions_groupId")

  @@map("groups")
}

model GroupUsers {
  id         Int      @id @default(autoincrement())
  gid        Int
  uid        Int
  createUid  Int?     @map("create_uid")
  createDate DateTime @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid   Int?     @map("write_uid")
  writeDate  DateTime @default(now()) @map("write_date") @db.Timestamp(6)
  group      Groups   @relation("groupUsers_gid", fields: [gid], references: [id], map: "group_users_gid_groups_id_fk", onDelete: Cascade, onUpdate: NoAction)
  user       Users    @relation("groupUsers_uid", fields: [uid], references: [id], map: "group_users_uid_users_id_fk", onDelete: Cascade, onUpdate: NoAction)

  @@unique([gid, uid], map: "group_user_uq")
  @@map("group_users")
}

model GroupPermissions {
  id         Int      @id @default(autoincrement())
  groupId    Int      @map("group_id")
  menu       String   @db.VarChar(60)
  permRead   Boolean  @default(false) @map("perm_read")
  permCreate Boolean  @default(false) @map("perm_create")
  permWrite  Boolean  @default(false) @map("perm_write")
  permDelete Boolean  @default(false) @map("perm_delete")
  createUid  Int?     @map("create_uid")
  createDate DateTime @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid   Int?     @map("write_uid")
  writeDate  DateTime @default(now()) @map("write_date") @db.Timestamp(6)
  group      Groups   @relation("groupPermissions_groupId", fields: [groupId], references: [id], map: "group_permissions_group_id_groups_id_fk", onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, menu], map: "group_menu_uq")
  @@map("group_permissions")
}

model Messages {
  id                     Int          @id @default(autoincrement())
  authorId               Int?         @map("author_id")
  model                  String       @db.VarChar(60)
  resId                  Int          @map("res_id")
  messageType            String       @default("note") @map("message_type") @db.VarChar(20)
  body                   String       @db.Text
  date                   DateTime     @default(now()) @db.Timestamp(6)
  createUid              Int?         @map("create_uid")
  createDate             DateTime     @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid               Int?         @map("write_uid")
  writeDate              DateTime     @default(now()) @map("write_date") @db.Timestamp(6)
  revChangeLogsMessageId ChangeLogs[] @relation("changeLogs_messageId")

  @@index([model, resId], map: "messages_res_idx")
  @@map("messages")
}

model ChangeLogs {
  id            Int      @id @default(autoincrement())
  messageId     Int      @map("message_id")
  field         String   @map("field_id") @db.VarChar(60)
  oldValueChar  String?  @map("old_value_char") @db.Text
  newValueChar  String?  @map("new_value_char") @db.Text
  oldValueFloat Decimal? @map("old_value_float") @db.Decimal(18, 2)
  newValueFloat Decimal? @map("new_value_float") @db.Decimal(18, 2)
  createUid     Int?     @map("create_uid")
  createDate    DateTime @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid      Int?     @map("write_uid")
  writeDate     DateTime @default(now()) @map("write_date") @db.Timestamp(6)
  message       Messages @relation("changeLogs_messageId", fields: [messageId], references: [id], map: "change_logs_message_id_messages_id_fk", onDelete: Cascade, onUpdate: NoAction)

  @@map("change_logs")
}

model EmailLogs {
  id                 Int       @id @default(autoincrement())
  model              String    @db.VarChar(60)
  resId              Int       @map("res_id")
  documentName       String    @map("document_name") @db.VarChar(60)
  emailTo            String    @map("email_to") @db.VarChar(200)
  subject            String    @db.VarChar(250)
  state              String    @default("diproses") @db.VarChar(20)
  failureReason      String?   @map("failure_reason") @db.Text
  mtppProviderRef    String?   @map("mtpp_provider_ref") @db.VarChar(200)
  mtppDeliveryStatus String?   @map("mtpp_delivery_status") @db.VarChar(40)
  attachmentId       Int?      @map("attachment_id")
  sentAt             DateTime  @default(now()) @map("sent_at") @db.Timestamp(6)
  statusAt           DateTime? @map("status_at") @db.Timestamp(6)
  createUid          Int?      @map("create_uid")
  createDate         DateTime  @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid           Int?      @map("write_uid")
  writeDate          DateTime  @default(now()) @map("write_date") @db.Timestamp(6)

  @@map("email_logs")
}

model Attachments {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(250)
  resModel   String   @map("res_model") @db.VarChar(60)
  resId      Int      @map("res_id")
  mimetype   String   @db.VarChar(120)
  storeFname String   @map("store_fname") @db.VarChar(250)
  fileSize   Int      @map("file_size")
  createUid  Int?     @map("create_uid")
  createDate DateTime @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid   Int?     @map("write_uid")
  writeDate  DateTime @default(now()) @map("write_date") @db.Timestamp(6)

  @@map("attachments")
}

model PaymentTerms {
  id                          Int           @id @default(autoincrement())
  name                        String        @db.VarChar(80)
  days                        Int           @default(0)
  note                        String?       @db.Text
  active                      Boolean       @default(true)
  createUid                   Int?          @map("create_uid")
  createDate                  DateTime      @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                    Int?          @map("write_uid")
  writeDate                   DateTime      @default(now()) @map("write_date") @db.Timestamp(6)
  revPartnersPaymentTermId    Partners[]    @relation("partners_paymentTermId")
  revSalesOrdersPaymentTermId SalesOrders[] @relation("salesOrders_paymentTermId")

  @@map("payment_terms")
}

model SalesPricelists {
  id                          Int                   @id @default(autoincrement())
  name                        String                @db.VarChar(120)
  active                      Boolean               @default(true)
  revPartnersSalesPricelistId Partners[]            @relation("partners_salesPricelistId")
  items                       SalesPricelistItems[] @relation("salesPricelistItems_pricelistId")

  @@map("sales_pricelists")
}

model Partners {
  id                                Int                  @id @default(autoincrement())
  parentId                          Int?                 @map("parent_id")
  type                              String               @default("company") @db.VarChar(20)
  name                              String               @db.VarChar(200)
  vat                               String?              @db.VarChar(40)
  email                             String?              @db.VarChar(200)
  phone                             String?              @db.VarChar(60)
  street                            String?              @db.Text
  city                              String?              @db.VarChar(80)
  customerRank                      Int                  @default(0) @map("customer_rank")
  supplierRank                      Int                  @default(0) @map("supplier_rank")
  paymentTermId                     Int?                 @map("property_payment_term_id")
  category                          String?              @db.VarChar(80)
  supplierNote                      String?              @map("mtpp_supplier_note") @db.Text
  mtppIsNewCustomer                 Boolean              @default(false) @map("mtpp_is_new_customer")
  salesPricelistId                  Int?                 @map("sales_pricelist_id")
  active                            Boolean              @default(true)
  createUid                         Int?                 @map("create_uid")
  createDate                        DateTime             @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                          Int?                 @map("write_uid")
  writeDate                         DateTime             @default(now()) @map("write_date") @db.Timestamp(6)
  paymentTerm                       PaymentTerms?        @relation("partners_paymentTermId", fields: [paymentTermId], references: [id], map: "partners_property_payment_term_id_payment_terms_id_fk", onDelete: NoAction, onUpdate: NoAction)
  pricelist                         SalesPricelists?     @relation("partners_salesPricelistId", fields: [salesPricelistId], references: [id], map: "partners_sales_pricelist_id_sales_pricelists_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revProductTemplatesMainSupplierId ProductTemplates[]   @relation("productTemplates_mainSupplierId")
  revSupplierPricesPartnerId        SupplierPrices[]     @relation("supplierPrices_partnerId")
  warehouses                        Warehouses[]         @relation("warehouses_partnerId")
  revSalesOrdersPartnerId           SalesOrders[]        @relation("salesOrders_partnerId")
  revSalesOrdersPartnerShippingId   SalesOrders[]        @relation("salesOrders_partnerShippingId")
  revPurchaseOrdersPartnerId        PurchaseOrders[]     @relation("purchaseOrders_partnerId")
  revPurchaseOrdersDestAddressId    PurchaseOrders[]     @relation("purchaseOrders_destAddressId")
  revStockTransfersPartnerId        StockTransfers[]     @relation("stockTransfers_partnerId")
  revJournalEntriesPartnerId        JournalEntries[]     @relation("journalEntries_partnerId")
  revJournalEntryLinesPartnerId     JournalEntryLines[]  @relation("journalEntryLines_partnerId")
  revPaymentsPartnerId              Payments[]           @relation("payments_partnerId")
  revBankStatementLinesPartnerId    BankStatementLines[] @relation("bankStatementLines_partnerId")
  revDocumentsPartnerId             Documents[]          @relation("documents_partnerId")
  revUsersPartnerId                 Users[]              @relation("users_partnerId")
  parent                            Partners?            @relation("partners_parentId", fields: [parentId], references: [id], map: "partners_parent_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  children                          Partners[]           @relation("partners_parentId")

  @@map("partners")
}

model Units {
  id                       Int                @id @default(autoincrement())
  name                     String             @db.VarChar(40)
  relativeFactor           Decimal            @default(1) @map("relative_factor") @db.Decimal(12, 4)
  active                   Boolean            @default(true)
  createUid                Int?               @map("create_uid")
  createDate               DateTime           @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                 Int?               @map("write_uid")
  writeDate                DateTime           @default(now()) @map("write_date") @db.Timestamp(6)
  revProductTemplatesUomId ProductTemplates[] @relation("productTemplates_uomId")

  @@map("units")
}

model ProductCategories {
  id                            Int                @id @default(autoincrement())
  name                          String             @db.VarChar(80)
  active                        Boolean            @default(true)
  revProductTemplatesCategoryId ProductTemplates[] @relation("productTemplates_categoryId")

  @@map("product_categories")
}

model ProductTemplates {
  id              Int                @id @default(autoincrement())
  uomId           Int                @map("uom_id")
  categoryId      Int?               @map("category_id")
  mainSupplierId  Int?               @map("main_supplier_id")
  name            String             @db.VarChar(200)
  type            String             @default("product") @db.VarChar(20)
  listPrice       Decimal            @default(0) @map("list_price") @db.Decimal(18, 2)
  descriptionSale String?            @map("description_sale") @db.Text
  mtppRoute       String             @default("stock") @map("mtpp_route") @db.VarChar(20)
  active          Boolean            @default(true)
  createUid       Int?               @map("create_uid")
  createDate      DateTime           @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid        Int?               @map("write_uid")
  writeDate       DateTime           @default(now()) @map("write_date") @db.Timestamp(6)
  uom             Units              @relation("productTemplates_uomId", fields: [uomId], references: [id], map: "product_templates_uom_id_units_id_fk", onDelete: NoAction, onUpdate: NoAction)
  category        ProductCategories? @relation("productTemplates_categoryId", fields: [categoryId], references: [id], map: "product_templates_category_id_product_categories_id_fk", onDelete: NoAction, onUpdate: NoAction)
  mainSupplier    Partners?          @relation("productTemplates_mainSupplierId", fields: [mainSupplierId], references: [id], map: "product_templates_main_supplier_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  products        Products[]         @relation("products_productTmplId")
  supplierPrices  SupplierPrices[]   @relation("supplierPrices_productTmplId")

  @@map("product_templates")
}

model Products {
  id                              Int                   @id @default(autoincrement())
  productTmplId                   Int                   @map("product_tmpl_id")
  defaultCode                     String                @unique(map: "products_default_code_unique") @map("default_code") @db.VarChar(40)
  active                          Boolean               @default(true)
  createUid                       Int?                  @map("create_uid")
  createDate                      DateTime              @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                        Int?                  @map("write_uid")
  writeDate                       DateTime              @default(now()) @map("write_date") @db.Timestamp(6)
  template                        ProductTemplates      @relation("products_productTmplId", fields: [productTmplId], references: [id], map: "products_product_tmpl_id_product_templates_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revSalesOrderLinesProductId     SalesOrderLines[]     @relation("salesOrderLines_productId")
  revPurchaseOrderLinesProductId  PurchaseOrderLines[]  @relation("purchaseOrderLines_productId")
  revStockMovesProductId          StockMoves[]          @relation("stockMoves_productId")
  revStockBalancesProductId       StockBalances[]       @relation("stockBalances_productId")
  revJournalEntryLinesProductId   JournalEntryLines[]   @relation("journalEntryLines_productId")
  revSalesPricelistItemsProductId SalesPricelistItems[] @relation("salesPricelistItems_productId")
  revStockRulesProductId          StockRules[]          @relation("stockRules_productId")

  @@map("products")
}

model SupplierPrices {
  id            Int              @id @default(autoincrement())
  partnerId     Int              @map("partner_id")
  productTmplId Int              @map("product_tmpl_id")
  price         Decimal          @db.Decimal(18, 2)
  discount      Decimal          @default(0) @db.Decimal(5, 2)
  minQty        Decimal          @default(0) @map("min_qty") @db.Decimal(12, 2)
  dateStart     DateTime?        @map("date_start") @db.Date
  dateEnd       DateTime?        @map("date_end") @db.Date
  createUid     Int?             @map("create_uid")
  createDate    DateTime         @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid      Int?             @map("write_uid")
  writeDate     DateTime         @default(now()) @map("write_date") @db.Timestamp(6)
  partner       Partners         @relation("supplierPrices_partnerId", fields: [partnerId], references: [id], map: "supplier_prices_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  template      ProductTemplates @relation("supplierPrices_productTmplId", fields: [productTmplId], references: [id], map: "supplier_prices_product_tmpl_id_product_templates_id_fk", onDelete: NoAction, onUpdate: NoAction)

  @@map("supplier_prices")
}

model Warehouses {
  id                                Int               @id @default(autoincrement())
  partnerId                         Int               @map("partner_id")
  name                              String            @db.VarChar(120)
  code                              String            @unique(map: "warehouses_code_unique") @db.VarChar(20)
  active                            Boolean           @default(true)
  createUid                         Int?              @map("create_uid")
  createDate                        DateTime          @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                          Int?              @map("write_uid")
  writeDate                         DateTime          @default(now()) @map("write_date") @db.Timestamp(6)
  partner                           Partners          @relation("warehouses_partnerId", fields: [partnerId], references: [id], map: "warehouses_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  locations                         Locations[]       @relation("locations_warehouseId")
  revSalesOrderLinesMtppWarehouseId SalesOrderLines[] @relation("salesOrderLines_mtppWarehouseId")
  revPurchaseOrdersWarehouseId      PurchaseOrders[]  @relation("purchaseOrders_warehouseId")
  revTransferTypesWarehouseId       TransferTypes[]   @relation("transferTypes_warehouseId")
  revStockRulesWarehouseId          StockRules[]      @relation("stockRules_warehouseId")

  @@map("warehouses")
}

model Locations {
  id                              Int              @id @default(autoincrement())
  warehouseId                     Int?             @map("warehouse_id")
  name                            String           @db.VarChar(120)
  completeName                    String           @map("complete_name") @db.VarChar(200)
  usage                           String           @db.VarChar(20)
  active                          Boolean          @default(true)
  createUid                       Int?             @map("create_uid")
  createDate                      DateTime         @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                        Int?             @map("write_uid")
  writeDate                       DateTime         @default(now()) @map("write_date") @db.Timestamp(6)
  warehouse                       Warehouses?      @relation("locations_warehouseId", fields: [warehouseId], references: [id], map: "locations_warehouse_id_warehouses_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revStockTransfersLocationId     StockTransfers[] @relation("stockTransfers_locationId")
  revStockTransfersLocationDestId StockTransfers[] @relation("stockTransfers_locationDestId")
  revStockMovesLocationId         StockMoves[]     @relation("stockMoves_locationId")
  revStockMovesLocationDestId     StockMoves[]     @relation("stockMoves_locationDestId")
  revStockBalancesLocationId      StockBalances[]  @relation("stockBalances_locationId")

  @@map("locations")
}

model SalesOrders {
  id                         Int               @id @default(autoincrement())
  name                       String            @unique(map: "sales_orders_name_unique") @db.VarChar(40)
  quotationNumber            String?           @unique(map: "sales_orders_quotation_number_unique") @map("mtpp_quotation_number") @db.VarChar(40)
  partnerId                  Int               @map("partner_id")
  partnerShippingId          Int?              @map("partner_shipping_id")
  userId                     Int?              @map("user_id")
  paymentTermId              Int?              @map("payment_term_id")
  dateOrder                  DateTime          @map("date_order") @db.Date
  dateConfirm                DateTime?         @map("date_confirm") @db.Date
  validityDate               DateTime?         @map("validity_date") @db.Date
  commitmentDate             DateTime?         @map("commitment_date") @db.Date
  state                      String            @default("draft") @db.VarChar(20)
  clientOrderRef             String?           @map("client_order_ref") @db.VarChar(80)
  amountUntaxed              Decimal           @default(0) @map("amount_untaxed") @db.Decimal(18, 2)
  amountTax                  Decimal           @default(0) @map("amount_tax") @db.Decimal(18, 2)
  amountTotal                Decimal           @default(0) @map("amount_total") @db.Decimal(18, 2)
  invoiceStatus              String            @default("no") @map("invoice_status") @db.VarChar(20)
  mtppProformaNumber         String?           @map("mtpp_proforma_number") @db.VarChar(40)
  mtppProformaDate           DateTime?         @map("mtpp_proforma_date") @db.Date
  mtppProformaNote           String?           @map("mtpp_proforma_note") @db.Text
  mtppDpMode                 String?           @map("mtpp_dp_mode") @db.VarChar(10)
  mtppDpPercent              Decimal?          @map("mtpp_dp_percent") @db.Decimal(6, 2)
  mtppDpAmount               Decimal?          @map("mtpp_dp_amount") @db.Decimal(18, 2)
  mtppTermPayment            String?           @map("mtpp_term_payment") @db.Text
  mtppTermDelivery           String?           @map("mtpp_term_delivery") @db.Text
  mtppTermValidity           String?           @map("mtpp_term_validity") @db.Text
  mtppTermWarranty           String?           @map("mtpp_term_warranty") @db.Text
  mtppTermHandover           String?           @map("mtpp_term_handover") @db.Text
  mtppTermStandard           String?           @map("mtpp_term_standard") @db.Text
  createUid                  Int?              @map("create_uid")
  createDate                 DateTime          @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                   Int?              @map("write_uid")
  writeDate                  DateTime          @default(now()) @map("write_date") @db.Timestamp(6)
  partner                    Partners          @relation("salesOrders_partnerId", fields: [partnerId], references: [id], map: "sales_orders_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  partnerShipping            Partners?         @relation("salesOrders_partnerShippingId", fields: [partnerShippingId], references: [id], map: "sales_orders_partner_shipping_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  paymentTerm                PaymentTerms?     @relation("salesOrders_paymentTermId", fields: [paymentTermId], references: [id], map: "sales_orders_payment_term_id_payment_terms_id_fk", onDelete: NoAction, onUpdate: NoAction)
  lines                      SalesOrderLines[] @relation("salesOrderLines_orderId")
  revPurchaseOrdersSaleId    PurchaseOrders[]  @relation("purchaseOrders_saleId")
  revStockTransfersSaleId    StockTransfers[]  @relation("stockTransfers_saleId")
  revJournalEntriesSaleId    JournalEntries[]  @relation("journalEntries_saleId")
  revPaymentsMtppSaleOrderId Payments[]        @relation("payments_mtppSaleOrderId")
  revDocumentsSaleOrderId    Documents[]       @relation("documents_saleOrderId")

  @@map("sales_orders")
}

model SalesOrderLines {
  id                                  Int                  @id @default(autoincrement())
  orderId                             Int                  @map("order_id")
  productId                           Int                  @map("product_id")
  name                                String               @db.Text
  productUomQty                       Decimal              @map("product_uom_qty") @db.Decimal(12, 2)
  qtyDelivered                        Decimal              @default(0) @map("qty_delivered") @db.Decimal(12, 2)
  qtyInvoiced                         Decimal              @default(0) @map("qty_invoiced") @db.Decimal(12, 2)
  priceUnit                           Decimal              @map("price_unit") @db.Decimal(18, 2)
  discount                            Decimal              @default(0) @db.Decimal(5, 2)
  priceSubtotal                       Decimal              @default(0) @map("price_subtotal") @db.Decimal(18, 2)
  purchasePrice                       Decimal              @default(0) @map("purchase_price") @db.Decimal(18, 2)
  margin                              Decimal              @default(0) @db.Decimal(18, 2)
  mtppWarehouseId                     Int?                 @map("mtpp_warehouse_id")
  mtppIsDropship                      Boolean              @default(false) @map("mtpp_is_dropship")
  sequence                            Int                  @default(10)
  createUid                           Int?                 @map("create_uid")
  createDate                          DateTime             @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                            Int?                 @map("write_uid")
  writeDate                           DateTime             @default(now()) @map("write_date") @db.Timestamp(6)
  order                               SalesOrders          @relation("salesOrderLines_orderId", fields: [orderId], references: [id], map: "sales_order_lines_order_id_sales_orders_id_fk", onDelete: Cascade, onUpdate: NoAction)
  product                             Products             @relation("salesOrderLines_productId", fields: [productId], references: [id], map: "sales_order_lines_product_id_products_id_fk", onDelete: NoAction, onUpdate: NoAction)
  warehouse                           Warehouses?          @relation("salesOrderLines_mtppWarehouseId", fields: [mtppWarehouseId], references: [id], map: "sales_order_lines_mtpp_warehouse_id_warehouses_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revPurchaseOrderLinesMtppSaleLineId PurchaseOrderLines[] @relation("purchaseOrderLines_mtppSaleLineId")
