// Gudang, surat jalan, dan stok

// Gudang; setiap principal memiliki satu gudang.
model Warehouses {
  id                                Int               @id @default(autoincrement())
  partnerId                         Int               @map("partner_id")
  name                              String            @db.VarChar(120)
  code                              String            @unique(map: "warehouses_code_unique") @db.VarChar(20)
  active                            Boolean           @default(true)
  createUid                         Int?              @map("create_uid")
  createDate                        DateTime          @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                          Int?              @map("write_uid")
  writeDate                         DateTime          @default(now()) @map("write_date") @db.Timestamp(6)
  partner                           Partners          @relation("warehouses_partnerId", fields: [partnerId], references: [id], map: "warehouses_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  locations                         Locations[]       @relation("locations_warehouseId")
  revSalesOrderLinesMtppWarehouseId SalesOrderLines[] @relation("salesOrderLines_mtppWarehouseId")
  revPurchaseOrdersWarehouseId      PurchaseOrders[]  @relation("purchaseOrders_warehouseId")
  revTransferTypesWarehouseId       TransferTypes[]   @relation("transferTypes_warehouseId")
  revStockRulesWarehouseId          StockRules[]      @relation("stockRules_warehouseId")

  @@index([partnerId], map: "warehouses_partner_id_idx")
  @@map("warehouses")
}

// Lokasi stok, baik di dalam gudang maupun lokasi asal dan tujuan barang.
model Locations {
  id                              Int              @id @default(autoincrement())
  warehouseId                     Int?             @map("warehouse_id")
  name                            String           @db.VarChar(120)
  completeName                    String           @map("complete_name") @db.VarChar(200)
  usage                           String           @db.VarChar(20)
  active                          Boolean          @default(true)
  createUid                       Int?             @map("create_uid")
  createDate                      DateTime         @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                        Int?             @map("write_uid")
  writeDate                       DateTime         @default(now()) @map("write_date") @db.Timestamp(6)
  warehouse                       Warehouses?      @relation("locations_warehouseId", fields: [warehouseId], references: [id], map: "locations_warehouse_id_warehouses_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revStockTransfersLocationId     StockTransfers[] @relation("stockTransfers_locationId")
  revStockTransfersLocationDestId StockTransfers[] @relation("stockTransfers_locationDestId")
  revStockMovesLocationId         StockMoves[]     @relation("stockMoves_locationId")
  revStockMovesLocationDestId     StockMoves[]     @relation("stockMoves_locationDestId")
  revStockBalancesLocationId      StockBalances[]  @relation("stockBalances_locationId")

  @@index([warehouseId], map: "locations_warehouse_id_idx")
  @@map("locations")
}

// Jenis dokumen gudang per gudang: Penerimaan Barang atau Surat Jalan, beserta kode nomornya.
model TransferTypes {
  id                             Int              @id @default(autoincrement())
  warehouseId                    Int?             @map("warehouse_id")
  name                           String           @db.VarChar(80)
  code                           String           @db.VarChar(20)
  sequenceCode                   String           @map("sequence_code") @db.VarChar(10)
  createUid                      Int?             @map("create_uid")
  createDate                     DateTime         @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid                       Int?             @map("write_uid")
  writeDate                      DateTime         @default(now()) @map("write_date") @db.Timestamp(6)
  warehouse                      Warehouses?      @relation("transferTypes_warehouseId", fields: [warehouseId], references: [id], map: "transfer_types_warehouse_id_warehouses_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revStockTransfersPickingTypeId StockTransfers[] @relation("stockTransfers_pickingTypeId")

  @@index([warehouseId], map: "transfer_types_warehouse_id_idx")
  @@map("transfer_types")
}

// Dokumen gudang: penerimaan barang dan surat jalan, termasuk dokumen susulan.
model StockTransfers {
  id             Int              @id @default(autoincrement())
  name           String           @unique(map: "stock_transfers_name_unique") @db.VarChar(40)
  pickingTypeId  Int              @map("picking_type_id")
  partnerId      Int?             @map("partner_id")
  saleId         Int?             @map("sale_id")
  purchaseId     Int?             @map("purchase_id")
  locationId     Int              @map("location_id")
  locationDestId Int              @map("location_dest_id")
  backorderId    Int?             @map("backorder_id")
  origin         String?          @db.VarChar(80)
  scheduledDate  DateTime?        @map("scheduled_date") @db.Date
  dateDone       DateTime?        @map("date_done") @db.Timestamp(6)
  state          String           @default("draft") @db.VarChar(20)
  note           String?          @db.Text
  createUid      Int?             @map("create_uid")
  createDate     DateTime         @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid       Int?             @map("write_uid")
  writeDate      DateTime         @default(now()) @map("write_date") @db.Timestamp(6)
  pickingType    TransferTypes    @relation("stockTransfers_pickingTypeId", fields: [pickingTypeId], references: [id], map: "stock_transfers_picking_type_id_transfer_types_id_fk", onDelete: NoAction, onUpdate: NoAction)
  partner        Partners?        @relation("stockTransfers_partnerId", fields: [partnerId], references: [id], map: "stock_transfers_partner_id_partners_id_fk", onDelete: NoAction, onUpdate: NoAction)
  sale           SalesOrders?     @relation("stockTransfers_saleId", fields: [saleId], references: [id], map: "stock_transfers_sale_id_sales_orders_id_fk", onDelete: NoAction, onUpdate: NoAction)
  purchase       PurchaseOrders?  @relation("stockTransfers_purchaseId", fields: [purchaseId], references: [id], map: "stock_transfers_purchase_id_purchase_orders_id_fk", onDelete: NoAction, onUpdate: NoAction)
  location       Locations        @relation("stockTransfers_locationId", fields: [locationId], references: [id], map: "stock_transfers_location_id_locations_id_fk", onDelete: NoAction, onUpdate: NoAction)
  locationDest   Locations        @relation("stockTransfers_locationDestId", fields: [locationDestId], references: [id], map: "stock_transfers_location_dest_id_locations_id_fk", onDelete: NoAction, onUpdate: NoAction)
  moves          StockMoves[]     @relation("stockMoves_pickingId")
  backorder      StockTransfers?  @relation("stockTransfers_backorderId", fields: [backorderId], references: [id], map: "stock_transfers_backorder_id_fk", onDelete: NoAction, onUpdate: NoAction)
  revBackorders  StockTransfers[] @relation("stockTransfers_backorderId")

  @@index([partnerId], map: "stock_transfers_partner_id_idx")
  @@index([locationId], map: "stock_transfers_location_id_idx")
  @@index([pickingTypeId], map: "stock_transfers_picking_type_id_idx")
  @@index([locationDestId], map: "stock_transfers_location_dest_id_idx")
  @@index([purchaseId], map: "stock_transfers_purchase_id_idx")
  @@index([saleId], map: "stock_transfers_sale_id_idx")
  @@index([backorderId], map: "stock_transfers_backorder_id_idx")
  @@map("stock_transfers")
}

// Baris barang pada dokumen gudang; yang sudah divalidasi menjadi riwayat mutasi stok.
model StockMoves {
  id             Int                 @id @default(autoincrement())
  pickingId      Int?                @map("picking_id")
  productId      Int                 @map("product_id")
  locationId     Int                 @map("location_id")
  locationDestId Int                 @map("location_dest_id")
  saleLineId     Int?                @map("sale_line_id")
  purchaseLineId Int?                @map("purchase_line_id")
  productUomQty  Decimal             @map("product_uom_qty") @db.Decimal(12, 2)
  quantity       Decimal             @default(0) @db.Decimal(12, 2)
  state          String              @default("draft") @db.VarChar(20)
  date           DateTime            @default(now()) @db.Timestamp(6)
  createUid      Int?                @map("create_uid")
  createDate     DateTime            @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid       Int?                @map("write_uid")
  writeDate      DateTime            @default(now()) @map("write_date") @db.Timestamp(6)
  picking        StockTransfers?     @relation("stockMoves_pickingId", fields: [pickingId], references: [id], map: "stock_moves_picking_id_stock_transfers_id_fk", onDelete: Cascade, onUpdate: NoAction)
  product        Products            @relation("stockMoves_productId", fields: [productId], references: [id], map: "stock_moves_product_id_products_id_fk", onDelete: NoAction, onUpdate: NoAction)
  location       Locations           @relation("stockMoves_locationId", fields: [locationId], references: [id], map: "stock_moves_location_id_locations_id_fk", onDelete: NoAction, onUpdate: NoAction)
  locationDest   Locations           @relation("stockMoves_locationDestId", fields: [locationDestId], references: [id], map: "stock_moves_location_dest_id_locations_id_fk", onDelete: NoAction, onUpdate: NoAction)
  saleLine       SalesOrderLines?    @relation("stockMoves_saleLineId", fields: [saleLineId], references: [id], map: "stock_moves_sale_line_id_sales_order_lines_id_fk", onDelete: NoAction, onUpdate: NoAction)
  purchaseLine   PurchaseOrderLines? @relation("stockMoves_purchaseLineId", fields: [purchaseLineId], references: [id], map: "stock_moves_purchase_line_id_purchase_order_lines_id_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([saleLineId], map: "stock_moves_sale_line_id_idx")
  @@index([productId], map: "stock_moves_product_id_idx")
  @@index([purchaseLineId], map: "stock_moves_purchase_line_id_idx")
  @@index([locationId], map: "stock_moves_location_id_idx")
  @@index([pickingId], map: "stock_moves_picking_id_idx")
  @@index([locationDestId], map: "stock_moves_location_dest_id_idx")
  @@map("stock_moves")
}

// Saldo stok fisik per produk per lokasi.
model StockBalances {
  id               Int       @id @default(autoincrement())
  productId        Int       @map("product_id")
  locationId       Int       @map("location_id")
  quantity         Decimal   @default(0) @db.Decimal(12, 2)
  reservedQuantity Decimal   @default(0) @map("reserved_quantity") @db.Decimal(12, 2)
  inDate           DateTime  @default(now()) @map("in_date") @db.Timestamp(6)
  createUid        Int?      @map("create_uid")
  createDate       DateTime  @default(now()) @map("create_date") @db.Timestamp(6)
  writeUid         Int?      @map("write_uid")
  writeDate        DateTime  @default(now()) @map("write_date") @db.Timestamp(6)
  product          Products  @relation("stockBalances_productId", fields: [productId], references: [id], map: "stock_balances_product_id_products_id_fk", onDelete: NoAction, onUpdate: NoAction)
  location         Locations @relation("stockBalances_locationId", fields: [locationId], references: [id], map: "stock_balances_location_id_locations_id_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, locationId], map: "stock_balance_uq")
  @@index([locationId], map: "stock_balances_location_id_idx")
  @@map("stock_balances")
}

// Batas stok minimum per produk per gudang.
model StockRules {
  id          Int        @id @default(autoincrement())
  productId   Int        @map("product_id")
  warehouseId Int        @map("warehouse_id")
  minQty      Decimal    @map("min_qty") @db.Decimal(12, 2)
  product     Products   @relation("stockRules_productId", fields: [productId], references: [id], map: "stock_rules_product_id_products_id_fk", onDelete: NoAction, onUpdate: NoAction)
  warehouse   Warehouses @relation("stockRules_warehouseId", fields: [warehouseId], references: [id], map: "stock_rules_warehouse_id_warehouses_id_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, warehouseId], map: "stock_rule_uq")
  @@index([warehouseId], map: "stock_rules_warehouse_id_idx")
  @@map("stock_rules")
}
