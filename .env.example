# salin menjadi .env lalu ganti nilainya
DB_PASSWORD=ganti-password-database
JWT_SECRET=ganti-dengan-rahasia-panjang-acak
# production = backend menolak berjalan bila JWT_SECRET kosong atau masih bawaan
APP_ENV=development
# kosongkan untuk mode simulasi (email tidak benar-benar dikirim, status "simulasi")
BREVO_API_KEY=
EMAIL_FROM=noreply@mtpp.co.id
EMAIL_FROM_NAME=PT Mentari Timur Prima Perkasa
# webhook Brevo: https://<domain>/api/email/webhook/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=ganti-token-webhook
# false = hanya grup, pengguna, akun, dan jurnal (tanpa data contoh)
SEED_DEMO=true
# untuk backup
GCS_BUCKET=gs://mtpp-backup
# Di server produksi, aktifkan baris berikut supaya semua perintah docker compose memakai pengaturan produksi
# COMPOSE_FILE=docker-compose.yml:infra/compose/production.yml
